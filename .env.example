# ============================================================================
#  NoteScout — шаблон переменных окружения
#  Скопируйте в .env и заполните реальными значениями:  cp .env.example .env
#  Файл .env никогда не коммитится в git.
# ============================================================================

# --- Домен и TLS -------------------------------------------------------------
# Домен, на котором будет доступен API. Caddy сам получит сертификат Let's Encrypt.
# Для локальной проверки можно указать localhost — тогда Caddy выпустит внутренний сертификат.
DOMAIN=notescout.example.com

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=notescout
POSTGRES_USER=notescout
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- JWT ---------------------------------------------------------------------
# ОБЯЗАТЕЛЬНО заменить. Минимум 32 байта. Сгенерировать:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48_and_paste_result_here
JWT_ISSUER=notescout-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Ограничение частоты запросов к /api/v1/auth/* ---------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_WINDOW=1m

# --- Бэкапы ------------------------------------------------------------------
# Расписание в формате crontab (время контейнера, по умолчанию UTC).
# Значение со пробелами берём в кавычки, чтобы парсер .env не обрезал его.
BACKUP_CRON="0 3 * * *"
BACKUP_ON_START=false
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=12
TZ=UTC

# Внешнее S3-совместимое хранилище (необязательно).
# Пока оставьте пустым — копии будут лежать только на том же VPS.
# Когда появится внешнее хранилище, достаточно заполнить эти переменные,
# скрипт backup.sh подхватит их автоматически.
#   S3_REMOTE — имя remote в конфигурации rclone, например "s3"
#   Пример настройки: docker compose exec backup rclone config
S3_REMOTE=
S3_BUCKET=
S3_PREFIX=notescout
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
