# ============================================================================
#  NoteScout — шаблон переменных окружения
#  Скопируйте в .env и заполните реальными значениями:  cp .env.example .env
#  Файл .env никогда не коммитится в git.
# ============================================================================

# --- Домен и TLS -------------------------------------------------------------
# Домен, на котором будет доступен API. Caddy сам получит сертификат Let's Encrypt.
# Для локальной проверки можно указать localhost — тогда Caddy выпустит внутренний сертификат.
DOMAIN=notescout.example.com

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=notescout
POSTGRES_USER=notescout
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- JWT ---------------------------------------------------------------------
# ОБЯЗАТЕЛЬНО заменить. Минимум 32 байта. Сгенерировать:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_run_openssl_rand_base64_48_and_paste_result_here
JWT_ISSUER=notescout-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Ограничение частоты запросов к /api/v1/auth/* ---------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_WINDOW=1m

# --- Бэкапы ------------------------------------------------------------------
# Расписание в формате crontab (время контейнера, по умолчанию UTC).
# Значение со пробелами берём в кавычки, чтобы парсер .env не обрезал его.
BACKUP_CRON="0 3 * * *"
BACKUP_ON_START=false
RETENTION_DAILY=7
RETENTION_WEEKLY=4
RETENTION_MONTHLY=12
TZ=UTC

# Внешнее S3-совместимое хранилище. ОБЯЗАТЕЛЬНО.
# Копии живут только здесь: без настроенного хранилища backup.sh не запускается
# вовсе, потому что сохранять копию было бы некуда. Локальных копий нет
# намеренно — диск сервера делится с базой и от потери сервера не спасает.
#
# Удалённое хранилище rclone собирает из переменных окружения, поэтому
# `rclone config` запускать не нужно: настройка лежит в .env, переживает
# пересоздание контейнера и переносится на другой сервер вместе с файлом.
#
# Имя remote зафиксировано, поэтому S3_REMOTE=notescout.
#
# Пример для cloud.ru (Evolution Object Storage, класс Standard):
#   S3_ENDPOINT=https://s3.cloud.ru
#   S3_REGION=ru-central-1
#   S3_ACCESS_KEY_ID=<ID тенанта>:<Key ID>   ← именно через двоеточие
#   S3_SECRET_ACCESS_KEY=<Key Secret>
#   S3_BUCKET=<имя бакета>
S3_REMOTE=
S3_BUCKET=
S3_PREFIX=notescout
S3_TYPE=s3
S3_PROVIDER=Other
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
