# ============================================================================
#  Caddy: TLS-терминация и reverse proxy для API.
#
#  Сертификат Let's Encrypt выпускается и продлевается автоматически. Нужен
#  домен, A-запись которого указывает на этот сервер.
#
#  Особенность площадки: порт 80 занят nginx с Zabbix и трогать его нельзя.
#  Поэтому Caddy работает только на 443, а сертификат получает проверкой
#  TLS-ALPN-01 — она проходит внутри TLS-рукопожатия на 443 и порт 80
#  не использует вовсе.
# ============================================================================

{
	# Caddy по умолчанию поднял бы слушатель на 80 для редиректа HTTP→HTTPS.
	# Порт занят, поэтому слушатель не создаём.
	auto_https disable_redirects
}

https://{$DOMAIN} {
	tls {
		issuer acme {
			# HTTP-проверка невозможна: порт 80 занят nginx. Без этой строки
			# Caddy выбирает тип проверки случайно, может сначала попробовать
			# HTTP-01, получить отказ и лишь затем перейти к TLS-ALPN-01 —
			# сертификат выпустится, но с задержкой и ошибками в журнале.
			disable_http_challenge
		}
	}

	encode zstd gzip

	# /actuator/* — служебные эндпоинты приложения. Наружу отдаём только health:
	# остальное (метрики, детали) доступно лишь изнутри docker-сети.
	@actuator {
		path /actuator/*
		not path /actuator/health /actuator/health/*
	}
	handle @actuator {
		respond 404
	}

	# Спецификация API и Swagger UI. Пока нужны для отладки мобильного клиента;
	# перед публичным запуском раскомментируйте блок, чтобы закрыть их.
	# @docs {
	# 	path /swagger-ui* /v3/api-docs*
	# }
	# handle @docs {
	# 	respond 404
	# }

	handle {
		reverse_proxy api:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Когда появится собственный домен и порт 80 освободится — раскомментируйте,
# и http:// начнёт перенаправляться на https://. В docker-compose.yml для этого
# нужно вернуть публикацию порта "80:80".
# http://{$DOMAIN} {
# 	redir https://{host}{uri} permanent
# }
